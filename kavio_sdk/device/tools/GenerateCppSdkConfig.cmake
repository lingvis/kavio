# Generate the build-tree CMake package consumed by Native Kavio Apps.
foreach(required_var IN ITEMS
        KAVIO_CONFIG_OUTPUT
        KAVIO_MAIN_LIBRARY
        KAVIO_SHARED_LIBRARY
        KAVIO_PROTO_LIBRARY
        KAVIO_PROTOBUF_LIBRARY
        KAVIO_JSONCPP_LIBRARY
        KAVIO_JSONCPP_INCLUDE_DIR
        KAVIO_INCLUDE_DIR
        KAVIO_PROTO_INCLUDE_DIR
        KAVIO_PROTOBUF_SOURCE_INCLUDE_DIR)
    if(NOT DEFINED ${required_var} OR "${${required_var}}" STREQUAL "")
        message(FATAL_ERROR "Missing required variable: ${required_var}")
    endif()
endforeach()

set(_template [=[
# Generated by kavio_sdk/device. Do not edit manually.
include(CMakeFindDependencyMacro)
find_dependency(Threads)

set(_KAVIO_DEVICE_SDK_MAIN "@KAVIO_MAIN_LIBRARY@")
set(_KAVIO_DEVICE_SDK_SHARED "@KAVIO_SHARED_LIBRARY@")
set(_KAVIO_DEVICE_SDK_PROTO "@KAVIO_PROTO_LIBRARY@")
set(_KAVIO_DEVICE_SDK_PROTOBUF "@KAVIO_PROTOBUF_LIBRARY@")
set(_KAVIO_DEVICE_SDK_JSONCPP "@KAVIO_JSONCPP_LIBRARY@")

foreach(_kavio_required_file IN ITEMS
        "${_KAVIO_DEVICE_SDK_MAIN}"
        "${_KAVIO_DEVICE_SDK_SHARED}"
        "${_KAVIO_DEVICE_SDK_PROTO}"
        "${_KAVIO_DEVICE_SDK_PROTOBUF}"
        "${_KAVIO_DEVICE_SDK_JSONCPP}")
    if(NOT EXISTS "${_kavio_required_file}")
        message(FATAL_ERROR
            "Kavio Device SDK artifact is missing: ${_kavio_required_file}\n"
            "Rebuild kavio_sdk/device before configuring the App.")
    endif()
endforeach()

if(NOT TARGET Kavio::DeviceSdk)
    add_library(Kavio::DeviceSdk STATIC IMPORTED)
    set_target_properties(Kavio::DeviceSdk PROPERTIES
        IMPORTED_LOCATION "${_KAVIO_DEVICE_SDK_MAIN}"
        INTERFACE_INCLUDE_DIRECTORIES
            "@KAVIO_INCLUDE_DIR@;@KAVIO_PROTO_INCLUDE_DIR@;@KAVIO_PROTOBUF_SOURCE_INCLUDE_DIR@;@KAVIO_JSONCPP_INCLUDE_DIR@"
        INTERFACE_LINK_LIBRARIES
            "${_KAVIO_DEVICE_SDK_SHARED};${_KAVIO_DEVICE_SDK_PROTO};${_KAVIO_DEVICE_SDK_PROTOBUF};${_KAVIO_DEVICE_SDK_JSONCPP};Threads::Threads;rt"
    )
endif()

if(NOT TARGET kavio_sdk)
    add_library(kavio_sdk INTERFACE IMPORTED)
    set_target_properties(kavio_sdk PROPERTIES
        INTERFACE_LINK_LIBRARIES Kavio::DeviceSdk
    )
endif()

unset(_KAVIO_DEVICE_SDK_MAIN)
unset(_KAVIO_DEVICE_SDK_SHARED)
unset(_KAVIO_DEVICE_SDK_PROTO)
unset(_KAVIO_DEVICE_SDK_PROTOBUF)
unset(_KAVIO_DEVICE_SDK_JSONCPP)
unset(_kavio_required_file)
]=])
string(CONFIGURE "${_template}" _content @ONLY)
file(WRITE "${KAVIO_CONFIG_OUTPUT}" "${_content}")
